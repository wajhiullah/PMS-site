# ==============================================================================
# PIEAS Materials Society (PMS) — Environment Template (.env.example)
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=3000
APP_ENV=production

# Database Configuration (SQLite with WAL Mode & Foreign Keys)
DATABASE_URL=sqlite://pms.db?mode=rwc

# Security: JWT Secret Key for Admin Authentication Sessions
# Generate a new cryptographic secret via: openssl rand -hex 32
JWT_SECRET=replace-with-a-secure-random-secret-key-in-production

# Initial Administrator Credentials (seeded only on first database initialization)
ADMIN_INITIAL_EMAIL=admin@pms.pieas.edu.pk
ADMIN_INITIAL_PASSWORD=ChangeMeStrongPassword2026!

# Storage Paths
UPLOAD_DIR=uploads
